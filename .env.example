# Copy to .env (local) or set in Cloudflare. Never commit real values.

# --- Public (baked into the browser bundle at build time) ---
# Set these as build variables in Cloudflare (Workers -> Settings -> Build -> Variables).
VITE_SUPABASE_URL=
# The anon / publishable key only. Never put the service role key in a VITE_ variable.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server only (set as Worker secrets: `wrangler secret put NAME`) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_SALT=

# Email notifications (Resend)
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# WhatsApp notifications (pick one: CallMeBot or WhatsApp Cloud API)
WHATSAPP_NOTIFY_TO=
CALLMEBOT_API_KEY=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
